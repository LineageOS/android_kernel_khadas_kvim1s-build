load("//vendor/amlogic/kernel:kernel_platform.bzl", "amlogic_kernel_platform")
load("//vendor/amlogic/gpu-modules/bifrost:defs.bzl", "mali_bifrost_module")
load("//vendor/amlogic/dhd-driver:defs.bzl", "bcmdhd_591_sdio_module")
load("//vendor/amlogic/media-modules:defs.bzl", "media_modules_module")
load(":modules.bzl", "COMMON_DRIVERS_MODULES", "GKI_MODULES_REMOVE", "KVIM1S_MODULES", "MODULES_OUT_REMOVE")

package(
    default_visibility = ["//visibility:public"],
)

bcmdhd_591_sdio_module(name = "wlan_ap6356", kernel_build = ":kvim1s")

mali_bifrost_module(name = "gpu_bifrost", kernel_build = ":kvim1s")

media_modules_module(name = "media", kernel_build = ":kvim1s")

amlogic_kernel_platform(
    name = "kvim1s",
    dtb_outs = [
        "kvim1s.dtb",
        "android_overlay_dt.dtbo",
    ],
    module_outs = [m for m in KVIM1S_MODULES + COMMON_DRIVERS_MODULES if m not in MODULES_OUT_REMOVE],
    gki_modules_remove = GKI_MODULES_REMOVE,
    build_config = "//vendor/amlogic/kernel:build.config.kvim1s.bazel",
    kmi_symbol_list = "//vendor/amlogic/kernel:android/abi_gki_aarch64_amlogic",
    kernel_modules = [
        ":wlan_ap6356",
        ":gpu_bifrost",
        ":media",
    ],
)
